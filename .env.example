# Скопируй в .env и заполни. .env никогда не коммитится.
# Подробности — docs/development/testing.md

# --- LLM ---
# Общий ключ пула. Нужен только для уровня тестов L2 (живая модель) и для локального запуска.
# Юнит- и интеграционные тесты (L0, L1) его не читают и работают на моке.
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek            # deepseek | mock
LLM_MODEL_FAST=deepseek-flash
LLM_MODEL_PRO=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
# Профиль единого агента (раньше LLM_PROFILE_CHAT): модель:thinking:effort
# LLM_PROFILE_AGENT=deepseek-flash:enabled:high

# --- Публичный Web Search (docs/development/public-search.md) ---
# Exa — основной; DEEPSEEK_API_KEY также даёт доступ к отдельному DeepSeek Search API.
# Без ключей приложение запускается, поиск сообщает о недоступности.
EXA_API_KEY=
SEARCH_MODE=auto                # auto | off | exa | deepseek
SEARCH_DEADLINE_S=15
SEARCH_MAX_CALLS=4
SEARCH_MAX_COST_USD=0.03
SEARCH_COOLDOWN_S=60

# --- Голосовой ввод: речь в текст (docs/development/speech-to-text.md) ---
# Groq Speech-to-Text. Ключ только на сервере (в production — отдельный speech.secrets, читает один api);
# без него микрофон отвечает «распознавание не работает». Опечатка в STT_* отключает диктовку с
# предупреждением в журнале, API при этом стартует.
GROQ_API_KEY=
STT_PROVIDER=groq               # groq | off
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=ru
STT_DEADLINE_S=45
STT_REQUESTS_PER_HOUR=60        # на пользователя
STT_SECONDS_PER_DAY=7200        # секунд записи на пользователя за сутки (120 мин)

# --- Тесты ---
# Явный опт-ин для тестов, которые тратят деньги. Без него L2 пропускаются.
BOTAI_LIVE_LLM=0
# Потолок расхода на один прогон L2 в долларах. Превышение — тест падает, а не продолжает.
BOTAI_LIVE_LLM_BUDGET_USD=0.50

# --- Локальная платформа (make db) ---
DATABASE_URL=postgresql+asyncpg://botai:botai@127.0.0.1:55432/botai
# Мастер-ключ шифрования секретов (KEK). Генерируется локально, в БД не хранится.
BOTAI_KEK=

# Подробные структурные события без содержимого страниц/сообщений/секретов.
BOTAI_DIAGNOSTICS=false

# --- Возобновляемое исследование источника (ADR-0011): пределы одного задания ---
BOTAI_RESEARCH_SLICE_SECONDS=90
BOTAI_RESEARCH_SLICE_STEPS=10
BOTAI_RESEARCH_MAX_SECONDS=1800
BOTAI_RESEARCH_MAX_TOKENS=1500000
BOTAI_RESEARCH_MAX_STEPS=100
BOTAI_RESEARCH_MAX_REQUESTS=2000
BOTAI_RESEARCH_CHECKPOINT_TTL_HOURS=24
