{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://botai.local/contracts/adapter-spec.schema.json",
  "title": "AdapterSpec",
  "description": "Спецификация адаптера источника для фабрики (ADR-0005). Вуз и документ — данные, а не код. Агент пишет только такие спецификации, исполняемый код — никогда.",
  "oneOf": [
    { "$ref": "#/$defs/recipeSpec" },
    { "$ref": "#/$defs/moodleWsSpec" },
    { "$ref": "#/$defs/icalSpec" },
    { "$ref": "#/$defs/documentSpec" }
  ],
  "$defs": {
    "recipeSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "recipe"],
      "properties": {
        "adapter": { "const": "recipe" },
        "recipe": { "$ref": "recipe.schema.json" }
      }
    },
    "moodleWsSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "origin", "functions"],
      "properties": {
        "adapter": { "const": "moodle_ws" },
        "origin": { "type": "string", "pattern": "^https://[a-z0-9.-]+$" },
        "service": { "type": "string", "default": "moodle_mobile_app", "maxLength": 60 },
        "functions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "core_webservice_get_site_info",
              "core_enrol_get_users_courses",
              "core_calendar_get_action_events_by_timesort",
              "core_calendar_get_calendar_upcoming_view",
              "mod_assign_get_assignments",
              "mod_assign_get_submission_status",
              "gradereport_user_get_grade_items"
            ]
          },
          "description": "Только чтение. Allowlist в коде совпадает с этим перечнем."
        },
        "horizonDays": { "type": "integer", "minimum": 1, "maximum": 180, "default": 60 }
      }
    },
    "icalSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "origin"],
      "properties": {
        "adapter": { "const": "ical" },
        "origin": { "type": "string", "pattern": "^https://[a-z0-9.-]+$" },
        "classify": {
          "type": "object",
          "additionalProperties": false,
          "description": "Как отличить занятие от дедлайна. Ссылка с токеном хранится в Vault (kind=ical_url), не здесь.",
          "properties": {
            "deadlineIf": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "zeroDuration": { "type": "boolean", "default": true },
                "categoryIn": { "type": "array", "items": { "type": "string", "maxLength": 60 }, "maxItems": 10 },
                "summaryPattern": { "type": "string", "maxLength": 200 }
              }
            }
          }
        }
      }
    },
    "documentSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "source"],
      "properties": {
        "adapter": { "const": "document" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["upload", "url", "google_doc", "google_sheet"] },
            "url": { "type": "string", "format": "uri" },
            "refreshEveryMinutes": { "type": "integer", "minimum": 0, "maximum": 10080, "default": 0 }
          }
        },
        "format": { "enum": ["pdf", "docx", "xlsx", "csv", "html", "text"] },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "description": "Если документ — таблица, из которой нужны строки (запись на экзамен, расписание сессии).",
          "required": ["kind", "columns"],
          "properties": {
            "kind": { "enum": ["scheduleEvents", "deadlines", "grades"] },
            "sheet": { "type": "string", "maxLength": 120 },
            "headerRow": { "type": "integer", "minimum": 0, "maximum": 50, "default": 0 },
            "rowFilter": {
              "type": "object",
              "additionalProperties": false,
              "description": "Как найти строки студента. Значение подставляется из профиля во время sync, в спецификации — только имя параметра.",
              "properties": {
                "column": { "type": "string", "maxLength": 120 },
                "equalsParam": { "enum": ["fullName", "email", "group", "studentId"] }
              }
            },
            "columns": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 16,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["column"],
                "properties": {
                  "column": { "type": "string", "maxLength": 120 },
                  "transform": { "enum": ["iso", "date", "time", "trim", "number"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
