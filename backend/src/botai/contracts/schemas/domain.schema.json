{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://botai.local/contracts/domain.schema.json",
  "title": "Botai domain",
  "description": "Учебные сущности в общем формате. Специфика вуза живёт в рецепте, а не здесь. У каждой записи известно происхождение и свежесть.",
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "description": "ULID" },
    "externalId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceUrl", "fetchedAt"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id", "description": "connectionId" },
        "sourceUrl": { "type": "string", "format": "uri", "description": "Откуда запись прочитана; для API-источника это не страница для открытия." },
        "openUrl": { "type": ["string", "null"], "format": "uri", "description": "Страница источника, где студент видит запись (FR-042). Для API-источника выводится из uiUrl рецепта; для HTML-источника это сама страница." },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "recipeRev": { "type": "integer", "minimum": 1 }
      }
    },
    "entityBase": {
      "type": "object",
      "required": ["id", "connectionId", "externalId", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "connectionId": { "$ref": "#/$defs/id" },
        "externalId": { "$ref": "#/$defs/externalId" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },

    "Space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "userId", "universityId", "title", "accentToken", "timeZone", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "userId": { "$ref": "#/$defs/id" },
        "universityId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,48}$" },
        "title": { "type": "string", "maxLength": 120 },
        "accentToken": { "type": "string", "pattern": "^accent-[a-z0-9-]{1,40}$" },
        "timeZone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },

    "Connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "spaceId", "origin", "kind", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "spaceId": { "$ref": "#/$defs/id" },
        "origin": { "type": "string", "pattern": "^https://[a-z0-9.-]+$" },
        "kind": {
          "enum": ["portal", "lms", "schedule", "site", "sheet", "doc", "document", "calendar", "other"]
        },
        "title": { "type": "string", "maxLength": 120 },
        "entryUrl": { "type": ["string", "null"] },
        "status": {
          "enum": ["draft", "learning", "active", "syncing", "stale", "needs_reauth", "error", "disabled"]
        },
        "lastSyncAt": { "type": ["string", "null"], "format": "date-time" },
        "nextSyncAt": { "type": ["string", "null"], "format": "date-time" },
        "recipeId": { "type": ["string", "null"] },
        "recipeRev": { "type": ["integer", "null"] },
        "error": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["code", "at"],
          "properties": {
            "code": { "type": "string" },
            "at": { "type": "string", "format": "date-time" },
            "detail": { "type": "string", "maxLength": 500 }
          }
        }
      },
      "description": "Секрет подключения в этой структуре отсутствует и никогда не возвращается клиентом."
    },

    "Course": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "maxLength": 300 },
            "code": { "type": ["string", "null"], "maxLength": 60 },
            "term": { "type": ["string", "null"], "maxLength": 60 },
            "description": { "type": ["string", "null"], "maxLength": 4000 },
            "url": { "type": ["string", "null"], "format": "uri" },
            "archived": { "type": "boolean", "default": false }
          }
        }
      ]
    },

    "ScheduleEvent": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["title", "kind", "startsAt", "endsAt"],
          "properties": {
            "title": { "type": "string", "maxLength": 300 },
            "kind": { "enum": ["lecture", "seminar", "lab", "exam", "consultation", "other"] },
            "courseId": { "type": ["string", "null"] },
            "startsAt": { "type": "string", "format": "date-time" },
            "endsAt": { "type": "string", "format": "date-time" },
            "format": { "enum": ["offline", "online", "hybrid", "unknown"], "default": "unknown" },
            "locationId": { "type": ["string", "null"] },
            "locationText": { "type": ["string", "null"], "maxLength": 200 },
            "teacherIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 10 },
            "teacherText": { "type": ["string", "null"], "maxLength": 300 },
            "url": { "type": ["string", "null"], "format": "uri" },
            "kindText": { "type": ["string", "null"], "maxLength": 120, "description": "Тип занятия словами источника («Зачётное занятие»); kind остаётся общим." },
            "address": { "type": ["string", "null"], "maxLength": 300, "description": "Адрес здания; аудитория — в locationText." },
            "group": { "type": ["string", "null"], "maxLength": 200, "description": "Группа или поток." },
            "lessonNumber": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
            "links": {
              "type": "array",
              "maxItems": 4,
              "description": "Онлайн-комнаты и материалы занятия: только http(s).",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["url", "label"],
                "properties": {
                  "url": { "type": "string", "format": "uri" },
                  "label": { "type": "string", "maxLength": 80 }
                }
              }
            },
            "attributes": {
              "type": "array",
              "maxItems": 8,
              "description": "Дополнительные значения под общими подписями («Корпус»); подпись задаёт рецепт и не содержит личных значений.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value"],
                "properties": {
                  "label": { "type": "string", "maxLength": 40 },
                  "value": { "type": "string", "maxLength": 200 }
                }
              }
            },
            "recurrence": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "description": "Если источник отдаёт правило, а не список занятий. Runner разворачивает его в события на горизонте синхронизации.",
              "required": ["dayOfWeek", "intervalWeeks", "until"],
              "properties": {
                "dayOfWeek": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
                "intervalWeeks": { "type": "integer", "minimum": 1, "maximum": 8 },
                "until": { "type": "string", "format": "date" }
              }
            }
          }
        }
      ]
    },

    "EventSource": {
      "type": "object",
      "additionalProperties": false,
      "description": "Источник, из которого прочитано занятие (FR-054). В ответе API у занятия их список: первый — основной источник расписания вуза, чьи значения занятие показывает.",
      "required": ["connectionId", "title"],
      "properties": {
        "connectionId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "maxLength": 120, "description": "Человеческое название источника, не адрес." }
      }
    },

    "EventDisagreement": {
      "type": "object",
      "additionalProperties": false,
      "description": "Источники одного вуза говорят о занятии разное (FR-054). Решает основной источник; здесь — что у остальных, либо что в основном такого занятия нет.",
      "required": ["kind", "detail"],
      "properties": {
        "kind": {
          "enum": ["time", "location", "teacher", "group", "address", "several", "not_in_primary"],
          "description": "Что расходится; several — больше одного поля; not_in_primary — похожее занятие есть в основном источнике в пределах семи дней, а в этот час нет (вероятно, перенесено или отменено)."
        },
        "detail": { "type": "string", "maxLength": 400, "description": "Коротко для человека: «Календарь» — ауд. 305." }
      }
    },

    "ScheduleEventView": {
      "description": "Занятие в ответе API чтения (`/schedule`, `/today`, инструмент агента). Не хранимая запись: занятия разных источников одного вуза, совпавшие по времени и названию, склеены при чтении (FR-054), хранимые строки остаются по источникам. Поля ниже — аддитивные: без них ответ тот же, что у ScheduleEvent.",
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/EventSource" },
          "description": "Все источники занятия, основной первым; больше одного — занятие склеено."
        },
        "disagreement": { "oneOf": [{ "$ref": "#/$defs/EventDisagreement" }, { "type": "null" }] }
      }
    },

    "Assignment": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "maxLength": 300 },
            "courseId": { "type": ["string", "null"] },
            "description": { "type": ["string", "null"], "maxLength": 20000 },
            "url": { "type": ["string", "null"], "format": "uri" },
            "maxScore": { "type": ["number", "null"] }
          }
        }
      ]
    },

    "Deadline": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["title", "dueAt", "state"],
          "properties": {
            "title": { "type": "string", "maxLength": 300 },
            "assignmentId": { "type": ["string", "null"] },
            "courseId": { "type": ["string", "null"] },
            "dueAt": { "type": "string", "format": "date-time" },
            "effectiveDueAt": {
              "type": ["string", "null"],
              "format": "date-time",
              "description": "Срок с учётом продления, если источник его отдаёт. Срочность считается по нему."
            },
            "state": { "enum": ["open", "submitted", "graded", "missed", "unknown"] },
            "url": { "type": ["string", "null"], "format": "uri" }
          }
        }
      ]
    },

    "Grade": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["value"],
          "properties": {
            "courseId": { "type": ["string", "null"] },
            "assignmentId": { "type": ["string", "null"] },
            "title": { "type": ["string", "null"], "maxLength": 300 },
            "value": { "type": ["number", "string"] },
            "scale": { "type": ["string", "null"], "maxLength": 60 },
            "weight": { "type": ["number", "null"] },
            "gradedAt": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      ]
    },

    "Person": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["name", "role"],
          "properties": {
            "name": { "type": "string", "maxLength": 200 },
            "role": { "enum": ["teacher", "assistant", "staff", "other"] },
            "contacts": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "email": { "type": ["string", "null"] },
                "url": { "type": ["string", "null"], "format": "uri" }
              }
            }
          }
        }
      ]
    },

    "Location": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "maxLength": 200 },
            "building": { "type": ["string", "null"], "maxLength": 200 },
            "address": { "type": ["string", "null"], "maxLength": 300 }
          }
        }
      ]
    },

    "NewsItem": {
      "allOf": [
        { "$ref": "#/$defs/entityBase" },
        {
          "type": "object",
          "required": ["title", "publishedAt"],
          "properties": {
            "title": { "type": "string", "maxLength": 300 },
            "body": { "type": ["string", "null"], "maxLength": 20000 },
            "publishedAt": { "type": "string", "format": "date-time" },
            "url": { "type": ["string", "null"], "format": "uri" }
          }
        }
      ]
    },

    "Document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "spaceId", "kind", "title", "fetchedAt", "hash"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "spaceId": { "$ref": "#/$defs/id" },
        "connectionId": { "type": ["string", "null"] },
        "kind": { "enum": ["file", "sheet", "page"] },
        "title": { "type": "string", "maxLength": 300 },
        "url": { "type": ["string", "null"], "format": "uri" },
        "mime": { "type": ["string", "null"], "maxLength": 120 },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },

    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "description": "Подтверждённый ответ на процедурный вопрос. Имеет срок годности и перепроверяется.",
      "required": ["id", "spaceId", "question", "answer", "sources", "confirmedAt", "staleAfter", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "spaceId": { "$ref": "#/$defs/id" },
        "question": { "type": "string", "maxLength": 500 },
        "answer": { "type": "string", "maxLength": 8000 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "fetchedAt"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "title": { "type": ["string", "null"], "maxLength": 200 },
              "fetchedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "staleAfter": { "type": "string", "format": "date-time" },
        "confidence": { "enum": ["confirmed", "likely", "unverified"] }
      }
    }
  }
}
