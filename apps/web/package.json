{
  "name": "@botai/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mocks": "VITE_MOCKS=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../../backend/openapi.json -o src/api/schema.gen.ts",
    "gen:blocks": "json2ts -i ../../contracts/agent-ui.schema.json -o src/api/agent-ui.gen.ts --unreachableDefinitions --maxItems -1"
  },
  "dependencies": {
    "@botai/design": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "msw": {
    "workerDirectory": [
      "src/mocks/worker"
    ]
  }
}
